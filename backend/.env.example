PROJECT_NAME="Village Asset Mapping System"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000
API_V1_STR="/api/v1"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# GIS Service Endpoints
GRAM_MANCHITRA_BASE_URL="https://grammanchitragis.nic.in/grammanchitra/rest/services"
GRAM_MANCHITRA_SOI_MP_URL="https://grammanchitragis.nic.in/grammanchitra/rest/services/SOI_Svamitva/SOI_MP/MapServer"
GRAM_MANCHITRA_SSL_VERIFY=False

SVAMITVA_POC_URL="https://grammanchitragis.nic.in/grammanchitra/rest/services/panchayat/svamitva_POC_Vehicle/MapServer"
SVAMITVA_SSL_VERIFY=False

OSM_OVERPASS_URL="https://overpass-api.de/api/interpreter"
OSM_USER_AGENT="VillageAssetMappingSystem/0.1.0"

# Ingestion Network Settings
HTTP_TIMEOUT_SECONDS=30.0
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_FACTOR=1.5

# Data Storage Directories
DATA_DIR="data"
RAW_DATA_DIR="data/raw"
PROCESSED_DATA_DIR="data/processed"
GENERATED_DATA_DIR="data/generated"
